# OpenAI API 金鑰,AI Agent 用來呼叫 GPT-4o-mini
OPENAI_API_KEY=your_openai_key_here

# 學員名單所在的 Google Sheet ID(試算表網址中 /d/ 和 /edit 之間那段)
GOOGLE_SHEET_ID=your_sheet_id_here

# 異常通報信件的寄件人 / 收件人 Gmail 帳號
GMAIL_SENDER=your_email@example.com

# n8n Chat Trigger 產生的 webhook 網址
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
